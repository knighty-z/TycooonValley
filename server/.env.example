# ===============================================
# TycoonVale Server Environment Configuration
# ===============================================

# Port on which the backend HTTP and WebSocket server listens
# (Render automatically assigns PORT; defaults to 4000 locally or 10000 on Render)
PORT=4000

# Allowed client origin for CORS and Socket.IO handshakes
# For local dev: http://localhost:5173
# For Vercel production: https://<your-app>.vercel.app (or '*' for wildcard matching)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (M0 Free Tier)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tycoonvale?retryWrites=true&w=majority
# Note: If omitted, the server operates in graceful high-speed In-Memory persistence mode
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/tycoonvale?retryWrites=true&w=majority

# Runtime Environment ('development' | 'production')
NODE_ENV=production
