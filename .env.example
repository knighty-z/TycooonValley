# =================================================================
# TYCOONVALE MONOREPO — PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================
# Copy the respective blocks below into your cloud provider dashboard:
# - Backend variables go into Render (Web Service Environment)
# - Frontend variables go into Vercel (Project Environment Variables)
# =================================================================

# -----------------------------------------------------------------
# 1. BACKEND VARIABLES (Render / Railway / Docker)
# -----------------------------------------------------------------
# Port assigned by hosting provider (defaults to 10000 on Render, 4000 locally)
PORT=10000

# Node execution mode
NODE_ENV=production

# Production URL of your Vercel frontend app (used for strict CORS validation)
# Supports specific Vercel URL or '*' during initial deployment testing
CLIENT_URL=https://<your-project>.vercel.app

# MongoDB Atlas M0 Cluster Connection URI
# Obtain from MongoDB Atlas -> Connect -> Drivers (Node.js)
# NOTE: If left empty, server safely runs in high-speed In-Memory persistence mode
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/tycoonvale?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 2. FRONTEND VARIABLES (Vercel)
# -----------------------------------------------------------------
# Public HTTPS URL of the deployed Render backend service
VITE_SERVER_URL=https://<your-backend-service-name>.onrender.com
