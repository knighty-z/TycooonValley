# ===============================================
# TycoonVale Client Environment Configuration
# ===============================================

# Supabase Project URL (base origin; /rest/v1 is automatically normalized if present)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Public Publishable / Anon Key ONLY (NEVER use secret or service_role keys!)
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-public-key>

# Legacy Express + Socket.IO server URL (retained until Supabase cutover is complete)
VITE_SERVER_URL=http://localhost:4000
